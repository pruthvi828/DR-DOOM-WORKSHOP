# ====================================================================
# JARVIS WORKSHOP - ENVIRONMENT CONFIGURATION
# ====================================================================
#
# STEP 1: Get your FREE Groq API key:
#         https://console.groq.com/keys
#
# STEP 2: Paste your key below:
#         GROQ_API_KEY=gsk_your_actual_key_here
#
# STEP 3: Save this file as ".env" (in the same directory)
#
# WARNING: NEVER commit your ".env" file to GitHub!
# ====================================================================

GROQ_API_KEY=

# Optional settings (pre-configured with sensible defaults):
GROQ_CHAT_MODEL=openai/gpt-oss-20b
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8765
JARVIS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
JARVIS_LOCAL_ACTIONS_ENABLED=false
